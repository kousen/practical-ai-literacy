{
  "name": "practical-ai-literacy",
  "version": "1.0.0",
  "description": "Practical AI Literacy — a half-day hands-on workshop",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export --output practical-ai-literacy-slides.pdf",
    "export:freshmen": "slidev export slides-freshmen.md --dark --output ai-tools-for-academic-success.pdf",
    "export:freshmen:light": "slidev export slides-freshmen.md --output ai-tools-for-academic-success-light.pdf"
  },
  "private": true,
  "overrides": {
    "slidev-component-progress": {
      "@slidev/client": "$@slidev/cli"
    },
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.62.0",
    "slidev-addon-qrcode": "^1.0.2",
    "slidev-component-progress": "^1.1.0"
  }
}
